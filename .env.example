# Lucepress — Variables d'environnement
# Copier ce fichier : cp .env.example .env
# Renseigner les valeurs. En production Netlify, les variables sont définies
# via le CLI `netlify-cli env:set` (jamais de secrets dans le repo).

# --- Base de données (PostgreSQL / Supabase) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Taille du pool de connexions pg (défaut 10).
# DATABASE_POOL_SIZE=10

# --- Authentification ---
# Secret JWT : min 32 caractères. Générer avec :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-32-chars-minimum-0123456789ABCDEF

# --- Cerveau IA (NVIDIA NIM, API OpenAI-compatible) ---
BUILT_IN_FORGE_API_URL=https://integrate.api.nvidia.com/v1
BUILT_IN_FORGE_API_KEY=«redacted:nvapi-...»

# --- SMTP Google (envoi d'e-mails) ---
# Utiliser un mot de passe d'application Gmail, pas le mot de passe du compte.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=votre-compte@gmail.com
SMTP_PASS=mot-de-passe-application
# Expéditeur (optionnel — sinon "Lucepress" <SMTP_USER> est utilisé).
# SMTP_FROM="Lucepres Sarl <votre-compte@gmail.com>"

# --- Frontend / CORS / Proxy ---
VITE_APP_ID=lucepress-prod
# Origines autorisées pour CORS (séparées par une virgule).
ALLOWED_ORIGINS=https://lucepress-gestion.netlify.app,http://localhost:3000
# Hops de proxy de confiance (Netlify = 1).
# TRUST_PROXY=1

# --- Rate limiting (optionnel) ---
# Plafond req/min par IP sur /api (0 = désactivé). Défaut 2000.
# API_RATE_LIMIT_MAX=2000

# --- Mode standalone (pnpm dev / pnpm start) ---
PORT=3000
NODE_ENV=production

# --- OAuth (optionnel, si serveur OAuth externe activé) ---
# OAUTH_SERVER_URL=https://auth.manus.im
# VITE_OAUTH_PORTAL_URL=https://auth.manus.im