# Railway — Variables à copier dans Railway > Variables
DATABASE_URL=mysql://user:***@mysql.railway.internal:3306/railway
# Pool mysql2 (défaut 10, min 2, max 50). 10 suffit pour 7–20 staff.
# DATABASE_POOL_SIZE=10
# Plafond req/min par IP sur /api (0 = désactivé). Défaut 2000.
# API_RATE_LIMIT_MAX=2000
JWT_SECRET=change-me-32-chars-minimum-0123456789ABCDEF
VITE_APP_ID=lucepress-prod
OAUTH_SERVER_URL=https://auth.manus.im
VITE_OAUTH_PORTAL_URL=https://auth.manus.im
ALLOWED_ORIGINS=https://ton-domaine.up.railway.app
APP_PUBLIC_URL=https://lucepress.213.156.135.139.sslip.io
PORT=3000
NODE_ENV=production
# Ollama Cloud API (compte gratuit)
BUILT_IN_FORGE_API_URL=https://api.ollama.com
BUILT_IN_FORGE_API_KEY=«redacted:sk-...»
# SMTP (invitations, reset mot de passe, envoi devis/factures)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=votre-compte@gmail.com
SMTP_PASS=mot-de-passe-application
# Optionnel — sinon `"Lucepress" <SMTP_USER>`
# SMTP_FROM="Lucepres Sarl <votre-compte@gmail.com>"